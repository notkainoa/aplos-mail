{
  "name": "aplos-mail-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Aplos Mail: desktop app, website and shared packages",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aplos/desktop",
    "desktop": "npm run desktop -w @aplos/desktop",
    "build": "npm run build -w @aplos/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package": "npm run package -w @aplos/desktop",
    "start": "npm run start -w @aplos/desktop",
    "verify:release:real": "npm run verify:release:real -w @aplos/desktop",
    "verify:hardening": "node apps/desktop/scripts/verify-hardening.mjs",
    "web": "npm run dev -w @aplos/web",
    "web:build": "npm run build -w @aplos/web",
    "web:preview": "npm run preview -w @aplos/web",
    "owners:check": "node scripts/audit/owners-check.mjs",
    "test:audit": "node --test \"scripts/audit/tests/*.test.mjs\"",
    "measure:budgets": "node scripts/audit/measure-budgets.mjs",
    "score:coverage": "node scripts/audit/hillclimb/scorers/coverage.mjs",
    "score:mutation": "node scripts/audit/hillclimb/scorers/mutation.mjs",
    "score:knip": "node scripts/audit/hillclimb/scorers/knip.mjs",
    "score:depcruise": "node scripts/audit/hillclimb/scorers/depcruise.mjs",
    "hillclimb": "node scripts/audit/hillclimb/run.mjs",
    "release": "node scripts/release.mjs",
    "release:build": "npm run release:build -w @aplos/desktop",
    "update-feed": "npm run update-feed -w @aplos/desktop --",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:browser": "playwright test -c tests/e2e/playwright.config.ts --project browser",
    "check:budgets": "node scripts/audit/check-budgets.mjs",
    "check:scratch": "node scripts/audit/check-scratch.mjs",
    "check:sqlite": "node scripts/audit/sqlite-floor.mjs",
    "scratch:sweep": "node scripts/audit/scratch-sweep.mjs",
    "test:engine:gmail-kept": "env APLOS_KILLPOINT_GMAIL_MODE=kept node scripts/audit/electron-node.mjs --import tsx --test packages/engine/tests/outbox/killpoint-gmail.1.test.ts packages/engine/tests/outbox/killpoint-gmail.2.test.ts",
    "test:engine": "node scripts/audit/electron-node.mjs --import tsx --test 'packages/engine/tests/**/*.test.ts'",
    "format": "prettier --write --no-error-on-unmatched-pattern 'apps/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'apps/*/scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}' 'apps/desktop/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'packages/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'packages/*/generated/**/*.{ts,mjs,json}' 'packages/*/scripts/**/*.{ts,mjs}' 'packages/*/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'scripts/**/*.{ts,mjs,cjs,mts,cts,js}' 'apps/*/*.{ts,mts,mjs,cjs,json}' '*.{json,mjs,cjs}' 'tools/**/*.{ts,mjs,cjs,js}' 'tests/**/*.{ts,mjs}' .prettierrc",
    "format:check": "prettier --check --no-error-on-unmatched-pattern 'apps/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'apps/*/scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}' 'apps/desktop/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'packages/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'packages/*/generated/**/*.{ts,mjs,json}' 'packages/*/scripts/**/*.{ts,mjs}' 'packages/*/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'scripts/**/*.{ts,mjs,cjs,mts,cts,js}' 'apps/*/*.{ts,mts,mjs,cjs,json}' '*.{json,mjs,cjs}' 'tools/**/*.{ts,mjs,cjs,js}' 'tests/**/*.{ts,mjs}' .prettierrc",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:baseline": "rm -f eslint-suppressions.json && eslint . --suppress-all",
    "lint:css": "stylelint \"apps/**/*.css\"",
    "lint:css:baseline": "rm -f stylelint-suppressions.json && stylelint \"apps/**/*.css\" --suppress",
    "test:lint": "node --test \"tools/lint/tests/*.test.mjs\" \"tools/lint/design/*.test.mjs\"",
    "check": "node scripts/audit/run-if-present.mjs format:check && npm run lint && npm run test:lint && npm run test:audit && npm run lint:css && npm run lint:design && npm run check:tokens && npm run check:contrast && npm run check:identity && node scripts/audit/run-if-present.mjs owners:check && npm run typecheck && npm run check:sqlite && npm run test:engine && npm test",
    "prepare": "node scripts/hooks/install.mjs",
    "check:tokens": "node apps/desktop/scripts/design/build-tokens.mjs --check",
    "check:contrast": "node apps/desktop/scripts/design/check-contrast.mjs --contrast",
    "check:identity": "node apps/desktop/scripts/design/check-contrast.mjs --identity",
    "lint:design": "node tools/lint/design/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "c8": "12.0.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.42.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
