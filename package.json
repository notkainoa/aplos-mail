{
  "name": "aplos-mail-monorepo",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Aplos Mail: desktop app, website and shared packages",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aplos/desktop",
    "dev:emulated": "npm run dev:emulated -w @aplos/desktop --",
    "eval:groq": "npm run eval:groq -w @aplos/desktop --",
    "eval:ask": "npm run eval:ask -w @aplos/desktop --",
    "bench:mailbox": "npm run bench:mailbox -w @aplos/desktop --",
    "desktop": "npm run desktop -w @aplos/desktop",
    "build": "npm run build -w @aplos/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package": "npm run package -w @aplos/desktop",
    "start": "npm run start -w @aplos/desktop",
    "verify:release": "npm run verify:release -w @aplos/desktop",
    "verify:large": "npm run verify:large -w @aplos/desktop",
    "web": "npm run dev -w @aplos/web",
    "web:build": "npm run build -w @aplos/web",
    "web:preview": "npm run preview -w @aplos/web",
    "release": "node scripts/release.mjs",
    "release:build": "npm run release:build -w @aplos/desktop",
    "update-feed": "npm run update-feed -w @aplos/desktop --",
    "format": "prettier --write --no-error-on-unmatched-pattern 'apps/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'apps/*/scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}' 'apps/desktop/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'packages/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'packages/*/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'scripts/**/*.{ts,mjs,cjs,mts,cts,js}' 'apps/*/*.{ts,mts,mjs,cjs,json}' '*.{json,mjs,cjs}' .prettierrc",
    "format:check": "prettier --check --no-error-on-unmatched-pattern 'apps/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'apps/*/scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}' 'apps/desktop/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'packages/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,css,json}' 'packages/*/tests/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}' 'scripts/**/*.{ts,mjs,cjs,mts,cts,js}' 'apps/*/*.{ts,mts,mjs,cjs,json}' '*.{json,mjs,cjs}' .prettierrc"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
