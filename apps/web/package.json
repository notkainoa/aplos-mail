{
  "name": "@aplos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplos Mail marketing site",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/check-claims.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:external": "node scripts/check-web-external.mjs",
    "test:checks": "node --test \"scripts/tests/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
