{
  "name": "@aplos/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A calm desktop inbox with Groq intelligence",
  "author": {
    "name": "Kainoa Newton",
    "email": "k@kainoa.me"
  },
  "license": "MIT",
  "main": "dist/main/electron.cjs",
  "scripts": {
    "dev": "tsx src/main/server.ts",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "notices": "node scripts/notices.mjs --out dist/notices/THIRD_PARTY_NOTICES.txt --require-chromium",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\" \"tests/*/**/*.test.ts\" \"src/renderer/**/*.test.ts\" \"src/renderer/**/*.test.tsx\" \"scripts/design/*.test.mjs\"",
    "package": "npm run build && npm run notices && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist",
    "start": "electron .",
    "verify:release:real": "node scripts/verify-release-real.mjs",
    "verify:hardening": "node scripts/verify-hardening.mjs",
    "release:build": "APLOS_RELEASE_BUILD=1 npm run build && npm run notices && node scripts/release-build.mjs",
    "release:publish": "APLOS_RELEASE_BUILD=1 npm run build && npm run notices && node scripts/release-build.mjs --publish always",
    "update-feed": "node scripts/fake-update-feed.mjs",
    "dmg-background": "electron scripts/build-dmg-background.cjs",
    "icon": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@csstools/css-tokenizer": "4.0.2",
    "domhandler": "6.0.1",
    "dotenv": "^17.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "12.0.0",
    "imapflow": "^2.4.3",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aplos/contract": "*",
    "@aplos/contract-fixture": "*",
    "@aplos/engine": "*",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.7.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.aplos.mail",
    "productName": "Aplos Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/bin/**",
      "!dist/notices/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/bin",
        "to": "bin"
      },
      {
        "from": "dist/notices",
        "to": "notices"
      }
    ],
    "mac": {
      "icon": "assets/AppIcon.icon",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dictate email and ask questions using Groq transcription.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Aplos Mail",
            "CFBundleURLSchemes": [
              "aplos",
              "mailto"
            ]
          }
        ]
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 160,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 200,
          "y": 190,
          "type": "file"
        },
        {
          "x": 600,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "sign": false,
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "notkainoa",
        "repo": "aplos-mail",
        "releaseType": "draft"
      }
    ],
    "artifactName": "Aplos-Mail-${version}-${arch}.${ext}"
  },
  "homepage": "https://github.com/notkainoa/aplos-mail",
  "repository": {
    "type": "git",
    "url": "https://github.com/notkainoa/aplos-mail.git"
  }
}
