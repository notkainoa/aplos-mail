{
  "name": "@aplos/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calm desktop inbox with Groq intelligence",
  "author": "Aplos Mail",
  "license": "MIT",
  "main": "dist/main/electron.cjs",
  "scripts": {
    "dev": "tsx src/main/server.ts",
    "dev:emulated": "tsx scripts/dev-emulated.ts",
    "eval:groq": "tsx scripts/evaluate-groq.ts",
    "eval:ask": "tsx scripts/ask-live.ts",
    "bench:mailbox": "tsx scripts/mailbox-benchmark.ts",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --mac dir",
    "start": "electron .",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:large": "node scripts/verify-large-mailbox.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.0",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.4.3",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.7.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.aplos.mail",
    "productName": "Aplos Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/bin/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dictate email and ask questions using Groq transcription.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Aplos Mail",
            "CFBundleURLSchemes": [
              "aplos",
              "mailto"
            ]
          }
        ]
      }
    },
    "asar": true
  }
}
