{
  "$description": "Identity reference colours for check-contrast.mjs --identity (DESIGN 2.3, 4.1 and 12.4). Every target token, in both themes, must sit at least `threshold` ΔE00 from every reference. Sources: the identity audit's de2000.py (tools/identity-audit/de2000.py in aplos-research) and research/email-clients/gaps/identity-collision-audit.md section 4. Names describe other products' colours so they can be avoided; nothing here is used in the app.",
  "threshold": 8.5,
  "targets": ["{color.accent}", "{color.hill}", "{color.dusk}", "{color.stamp}"],
  "notAvec": {
    "$description": "DESIGN 2.3 checks 2 and 3: the accent at least 10 from Avec's blue, and the Done colour at least 10 from Avec's greens, in both themes.",
    "minimum": 10,
    "checks": [
      { "token": "{color.accent}", "references": ["#0050ff"] },
      { "token": "{color.hill}", "references": ["#07aa04", "#03ce4c"] }
    ]
  },
  "shell": {
    "$description": "DESIGN 2.3 check 1: the shell is cool-neutral, Lab b* below 0 in both themes.",
    "token": "{color.shell}",
    "maxB": 0
  },
  "exceptions": [
    {
      "token": "{color.hill}",
      "mode": "dark",
      "reference": "#64ca56",
      "status": "provisional, awaiting owner decision",
