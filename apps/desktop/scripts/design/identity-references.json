{
  "$description": "Identity reference colours for check-contrast.mjs --identity (DESIGN 2.3, 4.1 and 12.4). Gate: every target token, in both themes, must sit at least `threshold` ΔE00 from every colour in `references`, which is exactly DESIGN 12.4's list: Avec's four colours plus the brand and link blues of Spark, Missive (including its dark shade), Mimestream (link), Airmail, Shortwave, Canary and Apple (system blue) from identity-collision-audit.md section 4. `advisoryReferences` holds every other colour in the identity audit's de2000.py; each target and advisory target is printed with its nearest advisory colour and never gated. An entry in `exceptions` (a gated distance under the threshold) needs a `decision` and a `reviewBy` date (YYYY-MM-DD); the check fails once that date has passed. Sources: tools/identity-audit/de2000.py in aplos-research and research/email-clients/gaps/identity-collision-audit.md section 4. Names describe other products' colours so they can be avoided; nothing here is used in the app.",
  "threshold": 8.5,
  "targets": ["{color.accent}", "{color.hill}", "{color.dusk}", "{color.stamp}"],
  "advisoryTargets": {
    "$description": "Printed with their nearest colour from both lists but not gated: DESIGN 12.4 limits the gate to the accent and commit colours. Whether tag colours join the gate is on the owner's decision list (tag-sky light is 3.76 from Mimestream's icon deep blue, dark 6.57 from Airmail's Mac icon ring).",
    "tokens": ["{tag.sky}", "{tag.sand}", "{tag.ember}"]
  },
  "notAvec": {
    "$description": "DESIGN 2.3 checks 2 and 3: the accent at least 10 from Avec's blue, and the Done colour at least 10 from Avec's greens, in both themes.",
    "minimum": 10,
    "checks": [
      { "token": "{color.accent}", "references": ["#0050ff"] },
      { "token": "{color.hill}", "references": ["#07aa04", "#03ce4c"] }
    ]
  },
  "shell": {
    "$description": "DESIGN 2.3 check 1: the shell is cool-neutral, Lab b* below 0 in both themes.",
    "token": "{color.shell}",
    "maxB": 0
  },
