# Keep real values in ignored .env (development) or ~/.config/aplos-mail/.env (packaged app).
GROQ_API_KEY=
# Default for every AI feature; each feature's model is picked in Settings → AI.
# GROQ_MODEL only applies to scripts that call Groq directly.
# Optional providers; set up in Settings → AI → Providers. OpenAI can also do Voice.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Your OpenCode Go plan key from https://opencode.ai/console.
OPENCODE_API_KEY=
# Only if Ollama (e.g. ollama.com) or an LM Studio server with auth turned on needs one.
OLLAMA_API_KEY=
LM_STUDIO_API_KEY=
# Only if your custom OpenAI-compatible server needs one; its address is set in Settings → AI.
CUSTOM_AI_API_KEY=
# Create your own Desktop OAuth client and enable Gmail API + Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register your own Microsoft Entra app (Mobile and desktop, redirect http://localhost, public client).
MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common
# Optional isolated mailbox directory for testing.
# APLOS_DATA_DIR=/absolute/path/to/mailbox
