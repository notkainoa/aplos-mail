# Keep real values in ignored .env (development) or ~/.config/aplos-mail/.env (packaged app).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Create your own Desktop OAuth client and enable Gmail API + Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional isolated mailbox directory for testing.
# APLOS_DATA_DIR=/absolute/path/to/mailbox
