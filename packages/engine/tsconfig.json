{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@aplos/contract/*": ["../contract/src/*"], "@aplos/engine/*": ["./src/*"] }
  },
  "include": ["src", "tests"]
}
