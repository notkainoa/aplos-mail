      "mustKeepText": [
        "Harbor Market autumn catalogue",
        "Free shipping on orders over 40",
        "Visit the shop"
      ],
      "notes": "Owner demo. Exactly three tracking pixels (1x1 attributes, 0x0 attributes, CSS 1px with opacity 0) and three ordinary sized images that must remain as remote images."
    }
  },
